# Domain / reverse proxy
# Local HTTP-only: APP_HOSTS=:80
# Production domain: APP_HOSTS=2aeventures.com,www.2aeventures.com
APP_HOSTS=2aeventures.com,www.2aeventures.com
APP_ORIGIN=https://2aeventures.com
HTTP_PORT=80
HTTPS_PORT=443

# Backend runtime
BACKEND_ENV=production
BACKEND_LOG_LEVEL=info
BACKEND_CORS_ORIGINS=https://2aeventures.com,https://www.2aeventures.com
BACKEND_ADMIN_TOKEN=change-this-admin-token
BACKEND_DATA_DIR=/app/data

# Frontend build/runtime
NEXT_PUBLIC_API_URL=/api/v1
